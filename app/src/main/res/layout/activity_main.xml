<?xml version="1.0" encoding="utf-8"?>
<!-- Sized in dp for a 960x540dp TV canvas (1080p and 4K both map to it). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Layer 1: Giant Apple-style 3D Clock in the upper sky, tucked behind the mountain foreground layer -->
    <LinearLayout
        android:id="@+id/depthClockBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.plume.GlassClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.82"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="EEEE, d. MMMM"
                android:format24Hour="EEEE, d. MMMM"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="#E6F0FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:alpha="0.82"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:textColor="#E6F0FF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <dev.plume.GlassClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-14dp"
            android:fontFamily="sans-serif-black"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textColor="#F2F6FF"
            android:textSize="118sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Layer 2: Foreground mountain ridge cutout that overlaps the lower part of the 3D clock -->
    <ImageView
        android:id="@+id/mountainForeground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Layer 3+: Main UI content (top-right mini icons, compact Continue Watching above, miniature Apple Dock at bottom) -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="18dp"
        android:paddingEnd="36dp"
        android:paddingBottom="12dp">

        <!-- Subtle top-right control bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/presetButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:alpha="0.6"
                android:contentDescription="Preset wechseln"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_preset" />

            <ImageView
                android:id="@+id/wifi"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0.6"
                android:contentDescription="@string/network_settings"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_wifi" />

            <ImageView
                android:id="@+id/sourcesButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:alpha="0.6"
                android:contentDescription="@string/sources"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_sources"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/allAppsButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:alpha="0.6"
                android:contentDescription="@string/all_apps"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_apps" />

            <ImageView
                android:id="@+id/systemSettings"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:alpha="0.6"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_settings" />

            <ImageView
                android:id="@+id/launcherSettings"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:alpha="0.6"
                android:contentDescription="@string/plume_settings"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

<!-- Compact Continue Watching row sitting right ABOVE the bottom Apple Dock -->
        <TextView
            android:id="@+id/watchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="2dp"
            android:alpha="0.65"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:text="@string/continue_watching"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:visibility="gone" />

        <dev.plume.SnapScrollView
            android:id="@+id/watchScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-16dp"
            android:layout_marginBottom="-2dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/watchRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </dev.plume.SnapScrollView>

        <!-- Authentic Apple Live Activity Media Capsule -->
        <LinearLayout
            android:id="@+id/nowPlayingPill"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_now_playing_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/nowPlayingArt"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_spotify" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nowPlayingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fontFamily="sans-serif-medium"
                    android:maxWidth="280dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/nowPlayingAppIcon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/logo_spotify"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/nowPlayingArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxWidth="260dp"
                        android:singleLine="true"
                        android:textColor="#B0C2D8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Animated Apple Waveform Equalizer -->
            <LinearLayout
                android:id="@+id/nowPlayingEq"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <View
                    android:id="@+id/eqBar1"
                    android:layout_width="3.5dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_eq_bar" />

                <View
                    android:id="@+id/eqBar2"
                    android:layout_width="3.5dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="2.5dp"
                    android:background="@drawable/bg_eq_bar" />

                <View
                    android:id="@+id/eqBar3"
                    android:layout_width="3.5dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="2.5dp"
                    android:background="@drawable/bg_eq_bar" />
            </LinearLayout>

            <!-- Interactive Playback Controls -->
            <ImageView
                android:id="@+id/nowPlayingPlayPause"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.9"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_pause" />

            <ImageView
                android:id="@+id/nowPlayingNext"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0.85"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>

        <!-- Only shown while editing the row (it carries the instructions). -->
        <TextView
            android:id="@+id/appsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Sleek miniature Apple Dock at the very bottom -->
        <dev.plume.SnapScrollView
            android:id="@+id/appScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-16dp"
            android:layout_marginBottom="-8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/appRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp" />

                <!-- Name of the focused app, slid under its tile (tvOS style). -->
                <dev.plume.FittingLabel
                    android:id="@+id/rowLabel"
                    android:layout_width="140dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="4dp"
                    android:alpha="0"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="11sp" />

                <!-- "App names: Always": every name under its tile, in place of rowLabel (same space). -->
                <LinearLayout
                    android:id="@+id/nameRow"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone" />
            </LinearLayout>
        </dev.plume.SnapScrollView>
    </LinearLayout>

    <!-- All apps: hidden until the Apps tile is pressed; Back closes it. -->
    <ScrollView
        android:id="@+id/allApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/allAppsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/all_apps"
                android:textSize="20sp" />

            <GridLayout
                android:id="@+id/allAppsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="8" />
        </LinearLayout>
    </ScrollView>

    <!-- Launcher settings: side panel over a dimmed home screen; Back closes it. -->
    <FrameLayout
        android:id="@+id/settingsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:visibility="gone">

        <dev.plume.GlassBox
            android:id="@+id/settingsPanel"
            android:layout_width="400dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="40dp"
            android:paddingEnd="48dp"
            android:paddingBottom="27dp">

            <TextView
                android:id="@+id/settingsCrumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:text="@string/plume_settings"
                android:textSize="20sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/settingsHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="3"
                android:minLines="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="13sp" />
        </dev.plume.GlassBox>
    </FrameLayout>
</FrameLayout>
